# OneMoreDay Environment Variables
# Copy these to your Vercel Project Settings > Environment Variables

# Cryptographic secret for signing session tokens (make this a long random string)
SESSION_SECRET=onemoreday_secret_change_this_to_a_random_64_char_string

# Pusher Channels credentials (get these free from pusher.com)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1
